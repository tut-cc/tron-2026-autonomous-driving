# Build outputs: regenerate with tools/make_evidence.py (or tools/build.py).
# Build/*.lld and Build/bsp_linker_info.h are linker inputs and ARE tracked.
/CPU0/Build/obj/
/CPU1/Build/obj/
/CPU*/Build/*.elf
/CPU*/Build/*.srec
/CPU*/Build/*.map
/CPU*/Build/link.rsp
/CPU*/Build/build_profile.json
/CPU*/Build/build_metadata.json
# Debugger / IDE / Python leftovers (tools/verify.py rejects these in the delivery)
JLinkLog.log
__pycache__/
*.pyc
.metadata/
# Evidence written by tools/make_evidence.py on every run (regenerate locally).
# tools/evidence_tag.json stays tracked: build.py / manifest.py / verify.py read it.
# M85Web/Application/web/fsdata.h stays tracked: firmware builds need it without Perl.
/docs/demo_autofix_*.log
/docs/MANIFEST.json
